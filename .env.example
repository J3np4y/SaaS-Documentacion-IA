POSTGRES_DB=docs_assistant
POSTGRES_USER=docs_assistant
POSTGRES_PASSWORD=change_me_locally
# OpenAI se usa para indexar nuevos documentos y responder preguntas RAG.
# No guardes una clave real en este archivo versionado.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# DATABASE_URL y TEST_DATABASE_URL se derivan de estos valores localmente.
# Si las defines en el entorno, esas URL explícitas tienen prioridad.
FRONTEND_ORIGIN=http://localhost:3000
# Solo para desarrollo HTTP local. Actívalo como true al servir sobre HTTPS.
SESSION_COOKIE_SECURE=false
# Opcional: directorio privado para archivos cargados (por defecto: .data/documents/).
# DOCUMENT_STORAGE_DIR=C:\ruta\privada\para\documentos
